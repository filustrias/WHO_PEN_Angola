---
import Base from '../layouts/Base.astro';
import { SECCOES, caminho, paginasOrdenadas } from '../navegacao';
import { calendario, rotuloPeriodo } from '../dados';

const paginas = await paginasOrdenadas();
const seccoes = SECCOES.map((s) => ({ ...s, paginas: paginas.filter((p) => p.secao === s.id) }));

// Marcos do calendário, com datas, para o cartão "Próximo marco" (escolhido no navegador)
const marcos = calendario().flatMap((l) => l.marcos.map((m) => ({ texto: m, quando: rotuloPeriodo(l.periodo, true), fim: l.periodo.fim, id: l.periodo.codigo })));

// Ilustração do topo: grelha de 100 pontos
const pontos = Array.from({ length: 100 }, (_, k) => ({ x: (k % 10) * 26 + 13, y: Math.floor(k / 10) * 26 + 13, k }));
const destaque = new Set([3, 14, 15, 22, 26, 31, 37, 43, 48, 52, 55, 58, 61, 64, 67, 73, 76, 81, 85, 88, 94]);
---
<Base titulo="Início" inicio>
  <section class="heroi">
    <div class="heroi-dentro">
      <div class="heroi-texto">
        <p class="sobretitulo">WHO PEN · PEN-Plus · Angola</p>
        <h1>Implementação de pacote essencial de cuidados de pessoas com condições crónicas em Angola</h1>
        <div class="heroi-accoes">
          <a class="botao botao-cheio" href={caminho('projecto/')}>Conhecer o projecto</a>
          <a class="botao" href={caminho('calendario/')}>Ver o calendário</a>
        </div>
      </div>
      <svg class="heroi-arte" viewBox="0 0 260 260" role="img" aria-label="Ilustração: grelha de cem pontos">
        {pontos.map((p) => (
          <circle cx={p.x} cy={p.y} r="8" class={destaque.has(p.k) ? 'ponto ponto-destaque' : 'ponto'} style={`--atraso:${(p.k % 10) * 40 + Math.floor(p.k / 10) * 25}ms`} />
        ))}
      </svg>
    </div>
  </section>

  <div class="inicio">
    <section class="faixa-numeros" aria-label="As duas iniciativas">
      <div class="numero cor-terracota">
        <p class="numero-rotulo">WHO PEN</p>
        <p class="numero-valor">70 mil <small>USD</small></p>
        <p class="numero-texto">Pacote de intervenções essenciais para DNT nos cuidados primários</p>
      </div>
      <div class="numero cor-petroleo">
        <p class="numero-rotulo">PEN-Plus</p>
        <p class="numero-valor">50 mil <small>USD/ano</small></p>
        <p class="numero-texto">DNT graves nos hospitais de primeira referência (valor à partida)</p>
      </div>
      <a class="numero numero-agora cor-ocre" href={caminho('calendario/')} data-marcos={JSON.stringify(marcos)} data-base={caminho('calendario/')}>
        <p class="numero-rotulo">Próximo marco</p>
        <p class="numero-valor numero-valor-texto">Calendário conjunto</p>
        <p class="numero-texto">Outubro de 2026 a Outubro de 2027 · {marcos.length} marcos</p>
      </a>
    </section>

    <section class="intro-texto">
      <p>Este site reúne os documentos de trabalho do estudo sobre a implementação do WHO PEN em Angola: o âmbito do projecto e o seu calendário, a ciência da implementação que o sustenta, o RE-AIM e o CFIR aplicados ao PEN, a evidência sobre o pacote, a produção dos protocolos clínicos a partir das lacunas de cuidado e o seguimento dos utentes.</p>
    </section>

    <section class="cartoes" aria-label="Secções">
      {seccoes.map((s) => (
        <article class={`cartao cor-${s.cor}`}>
          <h2><a href={caminho(s.paginas[0]?.rota ?? '')}>{s.rotulo}</a></h2>
          <p>{s.descricao}</p>
          {s.paginas.length > 1 && (
            <ul>
              {s.paginas.map((p) => <li><a href={caminho(p.rota)}>{p.titulo}</a></li>)}
            </ul>
          )}
        </article>
      ))}
    </section>
  </div>
</Base>

<script>
  // Mostra o primeiro marco que ainda não passou
  const cartao = document.querySelector<HTMLAnchorElement>('.numero-agora');
  if (cartao?.dataset.marcos) {
    const marcos: { texto: string; quando: string; fim: string; id: string }[] = JSON.parse(cartao.dataset.marcos);
    const proximo = marcos.find((m) => new Date(m.fim + 'T00:00:00').getTime() > Date.now());
    if (proximo) {
      cartao.querySelector('.numero-valor')!.textContent = proximo.texto;
      cartao.querySelector('.numero-texto')!.textContent = proximo.quando;
      cartao.href = `${cartao.dataset.base}#p-${proximo.id}`;
    }
  }
</script>
