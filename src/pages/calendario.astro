---
import Base from '../layouts/Base.astro';
import '../styles/calendario.css';
import { calendario, dataDaMeia, etapas, intervalo, nomeMes, rotuloPeriodo } from '../dados';

const linhas = calendario();
const blocos = etapas();

// Eixo em quinzenas, do primeiro ao último período do calendário
const inicioEixo = Math.min(...linhas.map((l) => l.periodo.meiaInicio));
const fimEixo = Math.max(...linhas.map((l) => l.periodo.meiaFim));
const meias = fimEixo - inicioEixo + 1;
const meses = Array.from({ length: Math.ceil(meias / 2) }, (_, k) => inicioEixo + k * 2);
const col = (meiaIni: number, meiaFim: number) => `grid-column:${meiaIni - inicioEixo + 1} / ${meiaFim - inicioEixo + 2}`;

// Cada faixa é uma linha da linha do tempo; os blocos com grupo ficam dentro de uma moldura
const faixas = [...new Set(blocos.map((b) => b.faixa))];
const LINHA_INICIAL = 3; // linha 1: meses; linha 2: espaço para o nome dos grupos
const linhaDe = (faixa: string) => LINHA_INICIAL + faixas.indexOf(faixa);
const grupos = [...new Set(blocos.filter((b) => b.grupo).map((b) => b.grupo))].map((nome) => {
  const membros = blocos.filter((b) => b.grupo === nome);
  return {
    nome,
    inicio: Math.min(...membros.map((m) => m.inicio.meiaInicio)),
    fim: Math.max(...membros.map((m) => m.fim.meiaFim)),
    linha: linhaDe(membros[0].faixa),
    membros,
  };
});
const linhaMarcos = LINHA_INICIAL + faixas.length;

const etapaDe = (meia: number) => blocos.find((e) => e.faixa === 'etapa' && meia >= e.inicio.meiaInicio && meia <= e.fim.meiaFim);
const totalMarcos = linhas.reduce((n, l) => n + l.marcos.length, 0);
const primeiro = linhas[0].periodo;
const ultimo = linhas[linhas.length - 1].periodo;
const posicaoMarco = (l: (typeof linhas)[number]) =>
  ((l.periodo.meiaInicio - inicioEixo + (l.periodo.meiaFim - l.periodo.meiaInicio + 1) / 2) / meias) * 100;
---
<Base titulo="Calendário" descricao="Calendário conjunto WHO PEN e PEN-Plus Angola, de Outubro de 2026 a Outubro de 2027." secao="calendario" rota="calendario/">
  <header class="cabecalho cor-ocre">
    <div class="cabecalho-dentro">
      <p class="sobretitulo">Calendário</p>
      <h1>Calendário conjunto WHO PEN e PEN-Plus</h1>
      <p class="subtitulo">De {nomeMes(primeiro.mes)} de {primeiro.ano} a {nomeMes(ultimo.mes)} de {ultimo.ano}: quinzenas até Maio de 2027 e meses a partir de Junho. Proposta de trabalho de 16 de Novembro de 2026.</p>
    </div>
  </header>

  <div class="pagina">
    <h2 class="cal-titulo">Blocos de actividades</h2>

    <section class="linha-tempo" aria-label="Linha do tempo dos blocos de actividades"
      data-inicio={dataDaMeia(inicioEixo)} data-fim={dataDaMeia(fimEixo + 1)}>
      <div class="lt-grelha" style={`--meses:${meias}`}>
        <div class="lt-meses" aria-hidden="true">
          {meses.map((m) => {
            const mes = (Math.floor(m / 2) % 12) + 1;
            const ano = Math.floor(Math.floor(m / 2) / 12);
            const marcaAno = mes === 1 || m === inicioEixo;
            return (
              <span class="lt-mes" style={col(m, m + 1)}>
                {nomeMes(mes, true)}{marcaAno && <small>{ano}</small>}
              </span>
            );
          })}
        </div>

        {grupos.map((g) => (
          <div class="lt-grupo" style={`${col(g.inicio, g.fim)};grid-row:2 / ${g.linha + 1}`}></div>
          <p class="lt-grupo-nome" style={`${col(g.inicio, g.fim)};grid-row:2`}>{g.nome}</p>
        ))}

        {blocos.map((b) => (
          <div class:list={['lt-bloco', `lt-bloco-${b.numero}`, { 'lt-no-grupo': b.grupo, 'lt-curta': b.fim.meiaFim - b.inicio.meiaInicio < 2 }]}
            style={`${col(b.inicio.meiaInicio, b.fim.meiaFim)};grid-row:${linhaDe(b.faixa)}`}>
            <span class="lt-num">{b.numero}</span>
            <strong>{b.fim.meiaFim - b.inicio.meiaInicio < 2 ? b.curto : b.nome}</strong>
          </div>
        ))}

        <p class="lt-faixa-rotulo" style={`grid-row:${linhaMarcos}`}>Marcos</p>
        <div class="lt-marcos" style={`grid-row:${linhaMarcos + 1};grid-column:1 / -1`}>
          {linhas.filter((l) => l.marcos.length).map((l) => (
            <button type="button" class="lt-marco" aria-expanded="false" aria-controls="lt-caixa"
              style={`left:calc(${posicaoMarco(l)}% - .6rem)`}
              data-quando={rotuloPeriodo(l.periodo)} data-marcos={JSON.stringify(l.marcos)} data-fim={l.periodo.fim}
              aria-label={`Marcos de ${rotuloPeriodo(l.periodo)}`}></button>
          ))}
        </div>
        <div class="lt-hoje" hidden><span>Hoje</span></div>
      </div>
    </section>
    <div class="lt-caixa" id="lt-caixa" role="status" hidden></div>

    <ol class="blocos">
      {blocos.filter((b) => !b.grupo).slice(0, 1).map((b) => (
        <li class={`bloco lt-bloco-${b.numero}`}>
          <span class="lt-num">{b.numero}</span>
          <div><h3>{b.nome}</h3><p class="bloco-quando">{intervalo(b.inicio, b.fim)}</p><p>{b.descricao}</p></div>
        </li>
      ))}
      {grupos.map((g) => (
        <li class="bloco-grupo">
          <p class="bloco-grupo-nome">{g.nome}</p>
          <ol>
            {g.membros.map((b) => (
              <li class={`bloco lt-bloco-${b.numero}`}>
                <span class="lt-num">{b.numero}</span>
                <div><h3>{b.nome}</h3><p class="bloco-quando">{intervalo(b.inicio, b.fim)}</p><p>{b.descricao}</p></div>
              </li>
            ))}
          </ol>
        </li>
      ))}
      {blocos.filter((b) => !b.grupo).slice(1).map((b) => (
        <li class={`bloco lt-bloco-${b.numero}`}>
          <span class="lt-num">{b.numero}</span>
          <div><h3>{b.nome}</h3><p class="bloco-quando">{intervalo(b.inicio, b.fim)}</p><p>{b.descricao}</p></div>
        </li>
      ))}
    </ol>

    <section class="cal-chaves" aria-label="Como ler o calendário">
      <article class="chave cor-savana">
        <h2>Conjunta</h2>
        <p>Reunião ou trabalho de campo comum aos dois pacotes, com financiamento e reporte separados.</p>
      </article>
      <article class="chave cor-terracota">
        <h2>Três níveis de participação</h2>
        <ol>
          <li>Cuidado aos utentes nos centros de saúde e hospitais municipais</li>
          <li>Gestão das unidades sanitárias</li>
          <li>Gestão provincial e planeamento</li>
        </ol>
      </article>
    </section>

    <div class="cal-barra">
      <div class="cal-filtros" role="group" aria-label="Mostrar">
        <button type="button" data-filtro="tudo" aria-pressed="true">Tudo</button>
        <button type="button" data-filtro="pen" aria-pressed="false">WHO PEN</button>
        <button type="button" data-filtro="plus" aria-pressed="false">PEN-Plus</button>
        <button type="button" data-filtro="marcos" aria-pressed="false">Só marcos</button>
      </div>
      <a class="cal-agora-ir" href="#" hidden>Ir para a quinzena actual ↓</a>
      <p class="cal-contagem">{linhas.length} períodos · {totalMarcos} marcos</p>
    </div>

    <div class="calendario" data-filtro="tudo">
      <div class="cal-cabecalho" aria-hidden="true">
        <span></span>
        <span class="cal-col-pen">WHO PEN <small>4 centros de saúde</small></span>
        <span class="cal-col-plus">PEN-Plus <small>2 hospitais municipais</small></span>
      </div>
      {linhas.map((l) => {
        const etapa = etapaDe(l.periodo.meiaInicio);
        return (
          <section class:list={['cal-periodo', { 'com-marcos': l.marcos.length }]} id={`p-${l.periodo.codigo}`}
            data-inicio={l.periodo.inicio} data-fim={l.periodo.fim}>
            <header class="cal-data">
              <p class="cal-mes">{nomeMes(l.periodo.mes)} <span>{l.periodo.ano}</span></p>
              {l.periodo.quinzena > 0 && <p class="cal-quinzena">{l.periodo.quinzena}.ª quinzena</p>}
              {etapa && <p class="cal-etapa">{etapa.numero}. {etapa.curto}</p>}
              <p class="cal-agora-marca" hidden>Agora</p>
            </header>
            {[['pen', 'WHO PEN', l.pen], ['plus', 'PEN-Plus', l.plus]].map(([id, nome, lista]) => (
              <div class={`cal-coluna cal-col-${id}`}>
                <p class="cal-coluna-nome">{nome}</p>
                {(lista as typeof l.pen).length ? (
                  <ul>
                    {(lista as typeof l.pen).map((a) => (
                      <li class:list={{ realizado: a.realizado }}>
                        {a.texto}
                        {a.realizado && <span class="etiqueta etiqueta-realizado">Realizado</span>}
                        {a.conjunta && <span class="etiqueta etiqueta-conjunta">Conjunta</span>}
                      </li>
                    ))}
                  </ul>
                ) : <p class="cal-vazio">Sem actividades previstas</p>}
              </div>
            ))}
            {l.marcos.length > 0 && (
              <div class="cal-marcos">
                <p class="cal-marcos-titulo">Marcos</p>
                <ul>{l.marcos.map((m) => <li>{m}</li>)}</ul>
              </div>
            )}
          </section>
        );
      })}
    </div>
  </div>
</Base>

<script>
  // Marcador "Hoje", período actual e filtros. Tudo calculado no navegador, para estar sempre actual.
  const agora = Date.now();
  const lt = document.querySelector<HTMLElement>('.linha-tempo');
  const hoje = lt?.querySelector<HTMLElement>('.lt-hoje');
  if (lt && hoje) {
    const ini = new Date(lt.dataset.inicio + 'T00:00:00').getTime();
    const fim = new Date(lt.dataset.fim + 'T00:00:00').getTime();
    if (agora >= ini && agora < fim) {
      hoje.style.left = `${((agora - ini) / (fim - ini)) * 100}%`;
      hoje.hidden = false;
    }
  }

  const actual = Array.from(document.querySelectorAll<HTMLElement>('.cal-periodo')).find((p) => {
    const ini = new Date(p.dataset.inicio + 'T00:00:00').getTime();
    const fim = new Date(p.dataset.fim + 'T00:00:00').getTime();
    return agora >= ini && agora < fim;
  });
  if (actual) {
    actual.classList.add('agora');
    actual.querySelector<HTMLElement>('.cal-agora-marca')!.hidden = false;
    const ir = document.querySelector<HTMLAnchorElement>('.cal-agora-ir');
    if (ir) { ir.href = `#${actual.id}`; ir.hidden = false; }
  }

  // Caixa dos marcos: abre ao passar o rato, ao focar com o teclado ou ao clicar
  const caixaMarco = document.querySelector<HTMLElement>('#lt-caixa');
  const marcos = Array.from(document.querySelectorAll<HTMLButtonElement>('.lt-marco'));
  let fixo: HTMLButtonElement | null = null;
  const mostrar = (b: HTMLButtonElement) => {
    if (!caixaMarco) return;
    const lista: string[] = JSON.parse(b.dataset.marcos ?? '[]');
    caixaMarco.innerHTML = '';
    const quando = document.createElement('p');
    quando.className = 'lt-caixa-quando';
    quando.textContent = b.dataset.quando ?? '';
    const ul = document.createElement('ul');
    for (const m of lista) { const li = document.createElement('li'); li.textContent = m; ul.append(li); }
    // Dias que faltam até ao último dia do período do marco (fim da quinzena ou do mês)
    const prazo = document.createElement('p');
    prazo.className = 'lt-caixa-prazo';
    if (b.dataset.fim) {
      const ultimoDia = new Date(b.dataset.fim + 'T00:00:00');
      ultimoDia.setDate(ultimoDia.getDate() - 1);
      const hoje = new Date();
      hoje.setHours(0, 0, 0, 0);
      const dias = Math.round((ultimoDia.getTime() - hoje.getTime()) / 86400000);
      const data = ultimoDia.toLocaleDateString('pt-PT', { day: 'numeric', month: 'long', year: 'numeric' });
      if (dias > 1) prazo.textContent = `Faltam ${dias} dias (até ${data})`;
      else if (dias === 1) prazo.textContent = `Falta 1 dia (até ${data})`;
      else if (dias === 0) prazo.textContent = `O prazo termina hoje (${data})`;
      else { prazo.textContent = `Prazo terminado a ${data}`; prazo.classList.add('passado'); }
    }
    caixaMarco.append(quando, ul, prazo);
    caixaMarco.hidden = false;
    const r = b.getBoundingClientRect();
    const largura = caixaMarco.offsetWidth;
    const esquerda = Math.min(Math.max(r.left + r.width / 2 - largura / 2 + scrollX, scrollX + 8), scrollX + document.documentElement.clientWidth - largura - 8);
    caixaMarco.style.left = `${esquerda}px`;
    caixaMarco.style.top = `${r.bottom + scrollY + 10}px`;
    caixaMarco.style.setProperty('--seta', `${r.left + r.width / 2 + scrollX - esquerda}px`);
    marcos.forEach((x) => x.setAttribute('aria-expanded', String(x === b)));
  };
  const esconder = () => {
    if (caixaMarco) caixaMarco.hidden = true;
    marcos.forEach((x) => x.setAttribute('aria-expanded', 'false'));
    fixo = null;
  };
  marcos.forEach((b) => {
    b.addEventListener('mouseenter', () => { if (!fixo) mostrar(b); });
    b.addEventListener('mouseleave', () => { if (!fixo) esconder(); });
    b.addEventListener('focus', () => mostrar(b));
    b.addEventListener('blur', () => { if (!fixo) esconder(); });
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      if (fixo === b) { esconder(); return; }
      fixo = b;
      mostrar(b);
    });
  });
  document.addEventListener('click', (e) => { if (fixo && !caixaMarco?.contains(e.target as Node)) esconder(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') esconder(); });
  document.querySelector('.linha-tempo')?.addEventListener('scroll', () => { if (!caixaMarco?.hidden) esconder(); });

  const caixa = document.querySelector<HTMLElement>('.calendario');
  document.querySelectorAll<HTMLButtonElement>('.cal-filtros button').forEach((b, _, todos) => {
    b.addEventListener('click', () => {
      todos.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      if (caixa) caixa.dataset.filtro = b.dataset.filtro;
    });
  });
</script>
